# ===== Panel =====
PORT=3000
# Dirección pública del servidor (necesaria para el logo, las aperturas y los clics en los correos)
BASE_URL=https://tu-dominio.com
ADMIN_USER=ligia
ADMIN_PASSWORD=pon-una-clave-segura
SESSION_SECRET=cadena-larga-aleatoria

# ===== Correo (SMTP) =====
# Ejemplo con Brevo: smtp-relay.brevo.com, puerto 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=hola@tu-dominio.com
FROM_NAME=Ferias y Fiestas de la Uva
REPLY_TO=
# Ritmo de envío: un correo cada N segundos
SEND_DELAY_SECONDS=10
# Máximo de correos por día (0 = sin límite). Útil para dominios nuevos.
DAILY_LIMIT=0
# Pie legal del correo
ORG_NAME=Ferias y Fiestas de la Uva · Villa del Rosario
ORG_ADDRESS=Villa del Rosario, Norte de Santander, Colombia

# ===== Instagram (API oficial de Meta) =====
IG_ACCESS_TOKEN=
IG_USER_ID=
# graph.facebook.com (inicio con Facebook) o graph.instagram.com (inicio con Instagram)
IG_API_HOST=graph.facebook.com
IG_API_VERSION=v23.0
