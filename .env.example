# =====================================================================
# Sala de Prensa Digital · variables de entorno
# En Vercel: Settings → Environment Variables. En local: copia este archivo a .env
# =====================================================================

# ---- Acceso al panel ----
# Varios usuarios: usuario:clave separados por coma
ADMIN_USERS=lamonalinda:clave-segura
# Nombre para mostrar de cada administrador principal
ADMIN_NOMBRES=lamonalinda:Ligia
SESSION_SECRET=una-cadena-larga-y-aleatoria
ORG_NAME=Alcaldía de Villa del Rosario
# Mensaje de bienvenida distinto en cada ingreso (solo para este usuario)
BIENVENIDA_USUARIO=lamonalinda
BIENVENIDA_FIRMA=Juan Carlos

# Dirección pública del panel (el dominio de Vercel o el propio)
BASE_URL=https://tu-proyecto.vercel.app

# ---- Base de datos (Vercel → Storage → Upstash Redis las crea solas) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Imágenes y videos: Cloudinary (gratis). Copia el "API environment variable" de cloudinary.com → Settings → API Keys ----
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Alternativa: Vercel Blob
BLOB_READ_WRITE_TOKEN=

# ---- Inteligencia artificial (Claude, de Anthropic) ----
# Clave en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ---- Correo (SMTP). Ejemplo con Brevo: smtp-relay.brevo.com, puerto 587 ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=hola@tu-dominio.com
FROM_NAME=Ferias y Fiestas de la Uva
REPLY_TO=
SEND_DELAY_SECONDS=10
# Máximo de correos por día (0 = sin límite). Útil si el dominio es nuevo.
DAILY_LIMIT=0
ORG_ADDRESS=Villa del Rosario, Norte de Santander, Colombia

# ---- Envío automático aunque el panel esté cerrado (opcional) ----
CRON_SECRET=otra-cadena-larga-y-aleatoria

# ---- Instagram (API oficial de Meta) ----
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_HOST=graph.facebook.com
IG_API_VERSION=v23.0

# Directorio: negocios de Google Maps con la API oficial (Places API New)
GOOGLE_MAPS_API_KEY=
